{
  "skill_name": "agentic-delivery",
  "triggers": [
    {
      "id": "implement-feature",
      "prompt": "Implement a feature end to end with QA and security review.",
      "should_trigger": true,
      "moments": [
        "implementing a feature"
      ]
    },
    {
      "id": "migration",
      "prompt": "Run a database migration through gated delivery.",
      "should_trigger": true,
      "moments": [
        "migration"
      ]
    },
    {
      "id": "typo-fix",
      "prompt": "Correct the spelling in a comment.",
      "should_trigger": false,
      "route_to": "agentic-ceo"
    },
    {
      "id": "multi-role-qa",
      "prompt": "Implement this change with independent QA, security and human approval before merge.",
      "should_trigger": true,
      "moments": ["gated multi-role", "implementing a feature"]
    },
    {
      "id": "plain-question",
      "prompt": "Explain what this regex does.",
      "should_trigger": false,
      "route_to": "deep-code-review"
    }
  ]
}
