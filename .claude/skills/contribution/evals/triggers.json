      "moments": ["upstream improvement", "generalizable lesson"]
    },
    {
      "id": "lesson-skillset",
      "prompt": "I learned a lesson about the skillset; hand it to a human to open the PR.",
      "should_trigger": true,
      "moments": ["lesson about the skillset", "reusable"]
    },
    {
      "id": "review-pr",
      "prompt": "Review this pull request for bugs.",
      "should_trigger": false,
      "route_to": "deep-code-review"
