{
  "skill_name": "deep-code-review",
  "triggers": [
    {
      "id": "review-pr",
      "prompt": "Review this PR.",
      "should_trigger": true,
      "moments": [
        "reviewing",
        "review"
      ]
    },
    {
      "id": "audit-harden",
      "prompt": "Audit and harden this repo before release.",
      "should_trigger": true,
      "moments": [
        "auditing",
        "hardening"
      ]
    },
    {
      "id": "red-team",
      "prompt": "Red-team this branch.",
      "should_trigger": true,
      "moments": [
        "red-teaming"
      ]
    },
    {
      "id": "write-feature",
      "prompt": "Build a new feature.",
      "should_trigger": false,
      "route_to": "agentic-delivery"
    }
  ]
}
