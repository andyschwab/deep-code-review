{
  "skill_name": "agentic-ceo",
  "triggers": [
    {
      "id": "session-start-multi-step",
      "prompt": "Starting a long session that touches review, a plan and a PR. Which skills apply?",
      "should_trigger": true,
      "moments": [
        "start of any multi-step",
        "start of any"
      ],
      "ceo_route": "starting a session"
    },
    {
      "id": "choosing-which-skill",
      "prompt": "Choosing a skill for this multi-step session: which skill applies?",
      "should_trigger": true,
      "moments": [
        "choosing a skill",
        "choosing which skill"
      ]
    },
    {
      "id": "routes-idea-critic-and-comms",
      "prompt": "Route this stage and area: which skill handles idea-critic, communication-structure, delivery and review?",
      "should_trigger": true,
      "moments": [
        "idea-critic before",
        "idea-critic"
      ],
      "ceo_route": "idea-critic"
    },
    {
      "id": "single-file-typo",
      "prompt": "Fix a typo in one README line.",
      "should_trigger": false,
      "route_to": "agentic-delivery"
    },
    {
      "id": "single-line-edit",
      "prompt": "Rename one variable in a helper.",
      "should_trigger": false,
      "route_to": "agentic-delivery"
    }
  ]
}
